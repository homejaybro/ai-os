# === 機密（最優先，絕不可 commit）===
.env*
!.env.example
_secrets/
.streamlit/secrets.toml

# === 依賴目錄（依技術棧，用不到的留著無害）===
node_modules/
.venv/
venv/
__pycache__/
*.pyc

# === 建置產出 ===
.next/
out/
dist/
build/
*.tsbuildinfo

# === 測試產出（Playwright）===
test-results/
playwright-report/
blob-report/
playwright/.cache/

# === Claude Code ===
# ⚠️ .gitignore 不支援行尾註解——# 只有在行首才是註解。
# 註解一律獨立成行，否則整串會被當成字面 pattern 而完全失效。
# 下一行：Claude Code 原生 --worktree 的預設位置
.claude/worktrees/
.claude/settings.local.json

# === 暫存產物（審查用，與 git 歷史重複，勿 commit）===
_管理/全分支diff.txt

# === 原則四閘門的執行期產物 ===
_管理/.verify-marker

# === CodeGraph 本地索引 ===
.codegraph/

# === 系統與 IDE ===
.DS_Store
Thumbs.db
.vscode/
.idea/

# === 專案自訂（依 STACK_RULES 追加）===
# 若技術棧使用檔案型資料庫（如 SQLite），測試專用的資料庫檔（例如 data.test.db）
# 應排除在版控外，比照正式資料庫檔的處理方式（見 tester.md 的「資料安全」章節）

